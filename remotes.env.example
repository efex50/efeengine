# Remote build settings for ./build.py --remote, cargo xtask --remote and scripts/remote.py.
# Copy to remotes.env (git ignored) and fill in. The environment overrides this file.

# Any ssh destination: a ~/.ssh/config alias, user@host or an IP. Required.
EFE_REMOTE_HOST=

# Tree location on the remote (relative = under the remote home). Default: remote-builds/<repo folder>
#EFE_REMOTE_DIR=

# Build jobs and test threads on the remote. Default: remote cores minus 3.
#EFE_REMOTE_JOBS=

# Fetch executables with debug info (1) instead of stripped (default; ~5x smaller downloads).
#EFE_REMOTE_KEEP_DEBUG=

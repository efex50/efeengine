; mod_adder.efa - a mod that offers a function to other scripts.
;
; Loaded with `Engine::load_mod(bytes, ModOptions::new("adder").allow("engine.mods"))`.
; During `init` it calls engine.mods.export; after init returns, `add` is registered as
; `adder.add` (namespace `adder`, owner = the mod) and shows up in the API index, so other
; scripts can import it (see mod_user.efa). The parameter names come from the names section.

import engine.mods.export

name db "add"
doc  db "Add two numbers."

export fn init() {
    reg status
    call engine.mods.export(name, name.len, doc, doc.len) -> status
    ret
}

export fn add(a: i64, b: i64) -> i64 {
    i64.add a, a, b
    ret a
}

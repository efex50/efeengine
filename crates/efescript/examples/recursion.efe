; recursion.efe - real recursion with call/ret; arguments and saved state live on the stack.
; Run from the crate dir:  cargo run -q -p efescript -- examples/recursion.efe
; Expected output:
;   sum(10) = 55
;   sum(100) = 5050
;   fib(10) = 55
; Exit code: 0
;
; Convention used here: the argument is passed in r1, the result comes back in r2.
; sum(n) = n + sum(n-1), sum(0) = 0.  `call` pushes an 8 byte return address, so the
; callee saves what it needs with push64 and restores it with pop64 before `ret`.

s1 db "sum(10) = "
s2 db "sum(100) = "
s3 db "fib(10) = "

; ---- sum(10)
mov rb, s1
mov rc, s1.len
call _printstr
mov r1, 10
call _sum
call _printnum

; ---- sum(100)
mov rb, s2
mov rc, s2.len
call _printstr
mov r1, 100
call _sum
call _printnum

; ---- fib(10)
mov rb, s3
mov rc, s3.len
call _printstr
mov r1, 10
call _fib
call _printnum

mov ra, 5050
mov rb, 0
syscall

; Print the string rb/rc without a trailing space or newline (Print would add a
; space), so it is printed byte by byte with Printchar.
label _printstr
mov r3, rb                 ; pointer
mov r4, rc                 ; remaining
label _ps_loop
cmp r4, 0
je _ps_end
mov rb, 0
mov bl, BYTEPTR [r3]
mov ra, 0
syscall
add64 r3, 1
sub64 r4, 1
jmp _ps_loop
label _ps_end
ret

; Print r2 as a decimal number followed by a newline.
; NumToString writes its text at rsp and advances rsp, so rsp is saved and restored
; (otherwise `ret` would pop its return address from the wrong place).
label _printnum
mov r5, rsp
mov rb, r2
mov rc, 0
mov rd, 0
mov ra, 3
syscall
mov ra, 2
syscall
mov rsp, r5
ret

; r1 = n  ->  r2 = n + sum(n-1)
label _sum
cmp r1, 0
jne _sum_rec
mov r2, 0
ret
label _sum_rec
push64 r1                  ; save n
sub64 r1, 1
call _sum                  ; r2 = sum(n-1)
pop64 r1                   ; restore n
add64 r2, r1
ret

; r1 = n  ->  r2 = fib(n); fib(0)=0, fib(1)=1
label _fib
cmp r1, 2
jlt _fib_base
push64 r1
sub64 r1, 1
call _fib                  ; r2 = fib(n-1)
pop64 r1
push64 r1                  ; keep n
push64 r2                  ; keep fib(n-1)
sub64 r1, 2
call _fib                  ; r2 = fib(n-2)
pop64 r3                   ; fib(n-1)
add64 r2, r3
pop64 r1
ret
label _fib_base
mov r2, r1
ret

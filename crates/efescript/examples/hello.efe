; hello.efe - the shortest program: define a string with `db` and print it.
; Run from the crate dir:  cargo run -q -p efescript -- crates/efescript/examples/hello.efe
; Expected output: hello world!
; Exit code: 0 (the program just runs off the end of the code)

msg db "hello world!"

mov ra, 2          ; syscall 2 = Println
mov rb, msg        ; rb = address of the string
mov rc, msg.len    ; rc = its length in bytes
syscall

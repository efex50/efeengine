; test.efe - reads a line from stdin (Readln, syscall 5) and echoes it.
; Run from the crate dir (type a line, or pipe one in):
;   echo ali | cargo run -q -p efescript -- examples/test.efe
; Expected output with the input "ali":
;   name?
;   hello ali
; Exit code 0. If stdin is empty the name is empty and it prints "hello ".

ask   db "name?"
greet db "hello "

mov ra, 2
mov rb, ask
mov rc, ask.len
syscall

mov ra, 5           ; Readln: text is written at rsp, rb = pointer, rc = length
syscall
mov r1, rb          ; keep the line
mov r2, rc

mov ra, 1           ; Print appends a space; drop the one in the string so it appears once
mov rb, greet
mov rc, greet.len
sub64 rc, 1         ; "hello" -> Print appends " "
syscall
mov ra, 2           ; Println the name
mov rb, r1
mov rc, r2
syscall

mov ra, 5050
mov rb, 0
syscall

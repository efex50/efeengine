; call.efe - call/ret with labels, ending with the Finish syscall.
; Run from the crate dir:  cargo run -q -p efescript -- examples/call.efe
; Expected output: "in _test" then "back in _main"; exit code 5.

msg1 db "in _test"
msg2 db "back in _main"

label _main
mov ah, 20          ; sub-register write: ah is byte 1 of ra
call _test          ; pushes the return address, jumps to _test

mov ra, 2           ; Println
mov rb, msg2
mov rc, msg2.len
syscall

mov ra, 5050        ; Finish
mov rb, 5           ; exit code
syscall

label _test
mov ra, 2
mov rb, msg1
mov rc, msg1.len
syscall
ret                 ; pops the return address

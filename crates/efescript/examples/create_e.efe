; create_e.efe - builds a string on the stack in a loop and writes it to a FILE with
; WriteFs (syscall 8). WARNING: it writes `./haha` in the WORKING DIRECTORY of the
; process (the path is built on the stack from the bytes 2E 2F 68 61 68 61 = "./haha"),
; so run it from a scratch directory, not from the repo:
;   cd $(mktemp -d) && efescript /path/to/examples/create_e.efe
; Expected output: none on stdout; the file `haha` (800 bytes: 100 copies of the
; 8 bytes "mustoç\n") is created. Exit code 0.
; (examples/haha in the repo is the output of an earlier run.)
mov r6, rsp ;reads the start of stack
push32 0x2E2F6861
push16 0x6861

; loop start
mov r2,100
mov r3,0 ; lenght

mov r1,rsp 
sub32 r1,r6

label _loop

;string
push64 0x6D7573746FC3A70A
add32 r3,8

sub32 r2,1  
test r2
jnz _loop

mov ra,8
mov rb,r1
mov rc,r3
mov rd,r6
syscall